FROM python:3.12.10-slim@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db
WORKDIR /app
ENV PYTHON_DOTENV_DISABLED=1 OTEL_SDK_DISABLED=true CREWAI_TELEMETRY_ENABLED=false LANGCHAIN_TRACING_V2=false
COPY requirements.frameworks.lock.txt .
RUN pip install --no-cache-dir -r requirements.frameworks.lock.txt && pip check
COPY packages/loomline-sdk packages/loomline-sdk
RUN pip install --no-cache-dir --no-deps ./packages/loomline-sdk
COPY examples examples
CMD ["python", "-m", "examples.interop_lab", "--offline", "--branch", "upstream"]
